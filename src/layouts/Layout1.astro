---
// Armazón del sitio. ÚNICO lugar donde se importan los CSS globales y las piezas con comportamiento.
import "../styles/icons.css";
import "../styles/project.css";
import "../styles/global.css";
import BaseHead from "../components/base-head.astro";
import Header from "../components/header.astro";
import WhatsApp from "../components/whatsapp.astro";
import Footer from "../sections/footer.astro";
import { cliente } from "../data/cliente";

interface Props {
  title?: string;
  description?: string;
  /** Página interna: los buscadores no la muestran. */
  oculta?: boolean;
  /** Página sola: sin cabecera, pie ni WhatsApp (p. ej. «en mantenimiento»). */
  sola?: boolean;
}

const { title, description, oculta, sola } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <BaseHead title={title} description={description} oculta={oculta} />
  </head>

  <body class:list={{ "con-barra": cliente.menuEnBarra && !sola }}>
    <a class="sr-only skip" href="#contenido">Ir al contenido</a>
    {!sola && <Header />}
    <main id="contenido">
      <slot />
    </main>
    {!sola && <Footer />}
    {!sola && <WhatsApp />}
    <script>
      import "../lib/ui";
    </script>
  </body>
</html>

<style is:global>
  /* Menú del celular en barra abajo: se reserva su alto (pie, avisos y WhatsApp lo leen de --tabbar-h) */
  .con-barra {
    --tabbar-h: 58px;
  }

  @media (min-width: 750px) {
    .con-barra {
      --tabbar-h: 0px;
    }
  }
</style>
