---
import Layout1 from "../../layouts/Layout1.astro";
import PortadaInterna from "../../components/portada-interna.astro";
import TituloSeccion from "../../components/titulo-seccion.astro";
import BloqueFoto from "../../components/bloque-foto.astro";
import TarjetasFoto from "../../components/tarjetas-foto.astro";
import Llamada from "../../sections/llamada.astro";
import { cliente } from "../../data/cliente";

const trabajos = [
  { imagen: "/img/automatizacion/1.avif", alt: "Corrección de equipo de laboratorio dañado o descalibrado", titulo: "Corrección" },
  { imagen: "/img/automatizacion/2.avif", alt: "Restauración de equipo de laboratorio obsoleto a estado funcional", titulo: "Restauración" },
  { imagen: "/img/automatizacion/3.avif", alt: "Automatización de equipo de laboratorio con sistema electrónico moderno", titulo: "Automatización" },
];
---

<Layout1
  title="Automatización y Restauración de Equipos de Laboratorio | HC Company S.A.S"
  description="Automatizamos, restauramos y adaptamos equipos de laboratorio obsoletos o fuera de servicio. Diseño y fabricación de mobiliario especializado. HC Company S.A.S, Colombia."
>
  <PortadaInterna etiqueta="Servicios" titulo="Automatización, restauración, adaptación, fábrica y asesoría" />

  <section>
    <TituloSeccion etiqueta="¿Es su caso?" titulo="Una segunda vida para sus equipos" />
    <BloqueFoto imagen="/img/servicios/calificacion.avif" alt="Equipo de laboratorio siendo automatizado por HC Company" ancho={779} alto={556}>
      <p class="pregunta">¿Ha sido valorado su equipo como obsoleto, inservible y/o no cumple?</p>
      <p class="pregunta">¿Requiere diseñar y elaborar mobiliario y equipo para ejecutar sus proyectos?</p>
      <a class="btn btn-accent" href={cliente.whatsapp} target="_blank" rel="noopener">
        <i class="bi bi-whatsapp" aria-hidden="true"></i>Contáctenos
      </a>
    </BloqueFoto>
  </section>

  <section id="fotos">
    <TituloSeccion etiqueta="Trabajos" titulo="Corrección, restauración y automatización" />
    <TarjetasFoto tarjetas={trabajos} llenas />
  </section>

  <Llamada />
</Layout1>

<style>
  .pregunta {
    color: var(--clr-text);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
</style>
