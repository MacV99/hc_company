---
import Layout1 from "../../layouts/Layout1.astro";
import PortadaInterna from "../../components/portada-interna.astro";
import TituloSeccion from "../../components/titulo-seccion.astro";
import Llamada from "../../sections/llamada.astro";

const calificaciones = [
  {
    sigla: "IQ",
    descripcion: "Verificación de instalación correcta y documentación",
    objetivo: "Asegurar que el equipo está instalado adecuadamente antes del uso",
  },
  {
    sigla: "OQ",
    descripcion: "Pruebas de funcionamiento y seguridad",
    objetivo: "Confirmar que el equipo funciona según sus especificaciones técnicas",
  },
  {
    sigla: "PQ",
    descripcion: "Evaluación del rendimiento en uso real",
    objetivo: "Garantizar que el equipo cumple con los requisitos de calidad a largo plazo",
  },
];
---

<Layout1
  title="Calificación IQ OQ PQ de Equipos de Laboratorio | HC Company S.A.S"
  description="Servicio de calificación IQ, OQ y PQ de equipos de laboratorio en Colombia. Verificación y validación de equipos según estándares de calidad. HC Company S.A.S."
>
  <PortadaInterna etiqueta="Servicios" titulo="Calificación: IQ · OQ · PQ" />

  <section>
    <TituloSeccion etiqueta="Calificación" titulo="IQ, OQ y PQ" />
    <ul class="fichas">
      {
        calificaciones.map(({ sigla, descripcion, objetivo }) => (
          <li class="card flex-column reveal">
            <strong class="sigla">{sigla}</strong>
            <dl>
              <dt class="eyebrow">Descripción</dt>
              <dd>{descripcion}</dd>
              <dt class="eyebrow">Objetivo</dt>
              <dd>{objetivo}</dd>
            </dl>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <TituloSeccion etiqueta="Verificación" titulo="Verificación" />
    <div class="verificacion">
      <div class="card flex-column reveal">
        <dl>
          <dt class="eyebrow">Descripción</dt>
          <dd>Comparación de las mediciones o rendimiento del equipo con un estándar de referencia (patrón) calibrado y certificado.</dd>
          <dt class="eyebrow">Objetivo</dt>
          <dd>Asegurar que el equipo funcione dentro de los límites establecidos y con la precisión requerida.</dd>
        </dl>
      </div>
      <img
        class="reveal"
        src="https://lirp.cdn-website.com/711523b1/dms3rep/multi/opt/WhatsApp+Image+2025-06-17+at+7.40.31+PM-1920w.jpeg"
        alt="Persona verificando temperatura con termómetro en recipiente de acero inoxidable"
        width="800"
        height="600"
        loading="lazy"
      />
    </div>
  </section>

  <Llamada />
</Layout1>

<style>
  .fichas {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .card {
    align-items: stretch;
    justify-content: flex-start;
    gap: var(--space-4);
    padding: var(--card-pad);
    box-shadow: none;
  }

  .sigla {
    color: var(--clr-accent-text);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }

  dd {
    margin-top: var(--space-1);
    color: var(--clr-text);
  }

  dd + dt {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: solid 1px var(--clr-border);
  }

  dt {
    display: block;
  }

  .verificacion {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  img {
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: cover;
    border: solid 1px var(--card-border);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 750px) {
    .fichas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .verificacion {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-7);
    }
  }
</style>
