---
import Layout1 from "../../layouts/Layout1.astro";
import PortadaInterna from "../../components/portada-interna.astro";
import TituloSeccion from "../../components/titulo-seccion.astro";
import BloqueFoto from "../../components/bloque-foto.astro";
import ListaColumnas from "../../components/lista-columnas.astro";
import TarjetasFoto from "../../components/tarjetas-foto.astro";
import Marcas from "../../sections/marcas.astro";
import Llamada from "../../sections/llamada.astro";

const laboratorios = [
  "Biología",
  "Biología Molecular",
  "Citogenética",
  "Botánica - Herbario",
  "Limnología",
  "Ictiología",
  "Análisis de Suelos",
  "Análisis Químico",
  "Análisis de Aguas",
  "Análisis de Semillas",
  "Fisiología Animal",
  "Fisiología Vegetal",
  "Geología",
  "Lodos",
  "Materiales",
  "Hidráulica",
  "Entomología",
];

const equipos = [
  "Balanzas",
  "Autoclaves",
  "Cabinas de Aislamiento",
  "Cabinas de Flujo Laminar y Bioseguridad",
  "Mantas",
  "Hornos",
  "Bloques de Calentamiento",
  "Muflas",
  "DBO",
  "Centrífugas",
  "Rotaevaporadores",
  "Deshumidificadores",
  "Neveras",
  "Refractómetros",
  "Floculadores",
  "Tamizadoras",
  "Baños maría",
  "Destiladores",
  "Planchas de Calentamiento",
];

const grupos = [
  {
    imagen: "/img/mantenimiento/analizador.avif",
    alt: "Analizador de alimentos y lácteos en laboratorio",
    titulo: "Alimentos, leches y carnes",
    texto:
      "Batidoras, Descremadoras, Analizadores, Embutidoras, Sierras sin Fin, Cámaras Climáticas, Molinos, Hornos, Estufas a gas, Empacadora al Vacío, Selladoras, Tajadoras, Baños de Cocción, Centrífugas Gerber.",
  },
  {
    imagen: "/img/mantenimiento/agitador.avif",
    alt: "Agitador orbital y destilador de nitrógeno en laboratorio",
    titulo: "Laboratorio",
    texto:
      "Agitador Orbital, Destilador de Nitrógeno, Cámara de Electroforesis, Estufas de Secado, Fusiómetros, Destiladores de Kjeldahl, Micrótomos, Campanas Extractoras.",
  },
  {
    imagen: "/img/mantenimiento/mufla.avif",
    alt: "Mufla de laboratorio para análisis de petróleo y materiales",
    titulo: "Petróleo y materiales",
    texto:
      "Viscosímetros Cinemáticos, Saybolt, Baños de Presión Reid, Muflas, Karl Fischer, Flash Point, Destilador de Crudos, Generadores de Humedad, Permeámetros, Presión Capilar.",
  },
];

const restauracion = [
  { imagen: "/img/mantenimiento/1.avif", alt: "Microscopio antes de restauración de iluminación LED" },
  { imagen: "/img/mantenimiento/2.avif", alt: "Proceso de adaptación de sistema LED en microscopio" },
  { imagen: "/img/mantenimiento/3.avif", alt: "Microscopio con nuevo sistema de iluminación LED instalado" },
  { imagen: "/img/mantenimiento/4.avif", alt: "Resultado final de restauración LED en equipo óptico de laboratorio" },
];
---

<Layout1
  title="Mantenimiento Preventivo y Correctivo de Equipos de Laboratorio | HC Company"
  description="Servicio de mantenimiento preventivo, correctivo y predictivo de equipos de laboratorio en Colombia: balanzas, autoclaves, microscopios, centrifugas, hornos y más. HC Company S.A.S."
>
  <PortadaInterna etiqueta="Servicios" titulo="Mantenimiento preventivo, correctivo y predictivo" />

  <section>
    <TituloSeccion etiqueta="Alcance" titulo="Alcance de servicio: laboratorios" />
    <BloqueFoto imagen="/img/servicios/calificacion.avif" alt="Equipo de laboratorio siendo calificado por técnico de HC Company" ancho={779} alto={556}>
      <ListaColumnas elementos={laboratorios} />
    </BloqueFoto>
  </section>

  <section>
    <TituloSeccion etiqueta="Equipos" titulo="Equipo de uso en mediciones y análisis de sustancias y materiales" />
    <BloqueFoto imagen="/img/servicios/mantenimiento.avif" alt="Técnico realizando mantenimiento preventivo de equipo de laboratorio" ancho={683} alto={475} invertido>
      <ListaColumnas elementos={equipos} />
    </BloqueFoto>
  </section>

  <section>
    <TituloSeccion etiqueta="Por sector" titulo="Equipos por tipo de laboratorio" />
    <TarjetasFoto tarjetas={grupos} />
  </section>

  <Marcas />

  <section id="instrumentos">
    <TituloSeccion etiqueta="Óptica" titulo="Instrumentos ópticos" />
    <div class="tres">
      <div class="card reveal">
        <ListaColumnas titulo="Microscopios" elementos={["Compuestos", "Invertidos", "Contraste de Fases", "Digitales", "De Fluorescencia", "Quirúrgicos"]} una />
      </div>
      <div class="card reveal">
        <ListaColumnas titulo="Otros instrumentos" elementos={["Refractómetros de mesa", "Colposcopios", "Estereoscopios"]} una />
      </div>
      <div class="card reveal">
        <ListaColumnas titulo="Restauración" elementos={["Adaptación sistema regulable iluminación led"]} una />
      </div>
    </div>
  </section>

  <section>
    <TituloSeccion etiqueta="Antes y después" titulo="Restauración y adaptación de sistema de iluminación LED" />
    <TarjetasFoto tarjetas={restauracion} pequenas />
  </section>

  <Llamada />
</Layout1>

<style>
  .tres {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  .tres .card {
    padding: var(--card-pad);
    box-shadow: none;
  }

  @media (min-width: 750px) {
    .tres {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
