---
// Pie: sigue el tema (gris muy suave en claro, oscuro en oscuro). Arriba la marca y las columnas; abajo el nombre en grande como firma.
import { cliente } from "../data/cliente";

const year = new Date().getFullYear();
const tel = cliente.telefono.replace(/\s/g, "");
---

<footer>
  <div class="arriba">
    <div class="marca flex-column">
      <a href="/" class="flex-row" aria-label={`${cliente.nombre}: inicio`}>
        <img src="/img/logo.avif" alt="" width="44" height="44" loading="lazy" />
        <strong>{cliente.nombre}</strong>
      </a>
      <p>{cliente.descripcion}</p>
    </div>

    <div class="columnas">
    <nav class="columna flex-column" aria-label="Menú del pie">
      <span class="eyebrow">Menú</span>
      {cliente.menu.map(({ texto, url }) => <a href={url}>{texto}</a>)}
    </nav>

    <div class="columna flex-column">
      <span class="eyebrow">Contacto</span>
      <a href={`tel:${tel}`}>{cliente.telefono}</a>
      <a href={`mailto:${cliente.correo}`}>{cliente.correo}</a>
      <span>{cliente.ubicacion}</span>
    </div>

    <div class="columna flex-column">
      <span class="eyebrow">Redes</span>
      {
        cliente.redes.map(({ nombre, icono, url }) => (
          <a class="flex-row" href={url} target="_blank" rel="noopener">
            <i class={`bi ${icono}`} aria-hidden="true" />
            {nombre}
          </a>
        ))
      }
    </div>
    </div>
  </div>

  <div class="abajo flex-row">
    <small>© {year} {cliente.legal.razonSocial}</small>
    <small>Hecho por MacV</small>
  </div>

  <p class="firma" aria-hidden="true" data-texto={cliente.nombre}></p>
</footer>

<style>
  footer {
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-7);
    padding-bottom: calc(var(--space-5) + var(--tabbar-h));
    overflow: hidden;
    background-color: var(--footer-bg);
    border-top: solid 1px var(--clr-border);
    color: var(--footer-fg);
  }

  .arriba {
    display: grid;
    gap: var(--space-6);
  }

  /* Las columnas se acomodan solas según el ancho (1, 2 o 3 por fila) */
  .columnas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-6) var(--space-5);
  }

  .marca {
    align-items: flex-start;
    justify-content: flex-start;
    gap: var(--space-3);
  }

  .marca a {
    gap: var(--space-3);
    color: var(--footer-fg);
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  .marca img {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .marca p {
    max-width: 38ch;
    color: var(--footer-muted);
  }

  .columna {
    align-items: flex-start;
    justify-content: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .columna .eyebrow {
    margin-bottom: var(--space-1);
    color: var(--footer-muted);
  }

  .columna a,
  .columna span:not(.eyebrow) {
    gap: var(--space-2);
    color: var(--footer-fg);
    overflow-wrap: anywhere;
  }

  .abajo {
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-top: var(--space-4);
    border-top: solid 1px var(--footer-border);
  }

  small,
  small a {
    color: var(--footer-muted);
    font-size: var(--text-xs);
  }

  /* Firma: el nombre en grande, casi invisible, cortado por el borde de abajo.
     Es adorno: se pinta desde el atributo para que no cuente como texto repetido de la página */
  .firma::before {
    content: attr(data-texto);
  }

  .firma {
    margin-bottom: calc(var(--space-7) * -1);
    color: var(--footer-hover-bg);
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 15vw, 11rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    white-space: nowrap;
    user-select: none;
  }

  @media (hover: hover) {
    .columna a:hover,
    small a:hover {
      color: var(--footer-fg);
      text-decoration: underline;
    }
  }

  /* Computador: la marca a la izquierda y las columnas a la derecha */
  @media (min-width: 750px) {
    .arriba {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-7);
    }
  }

</style>
